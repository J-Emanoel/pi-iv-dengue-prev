# Copie para .env na raiz e preencha com a conexão PostgreSQL do projeto.
# Pode ser o banco no Supabase ou um PostgreSQL local.
# Caracteres especiais na senha precisam estar codificados na URL.
DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@HOST:5432/postgres?sslmode=require
API_URL=http://127.0.0.1:8000

# Assistente: configure somente no .env local, após conferir o modelo na conta Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
